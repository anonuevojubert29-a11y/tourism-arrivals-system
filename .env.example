# Leave this unset (or blank) to run the app with zero setup — it will use
# browser localStorage automatically as a demo/offline fallback.
#
# Set this to your backend's URL to use the real MySQL-backed API in server/
# instead. Copy this file to .env and uncomment the line below once the
# server is running (see server/README instructions in the project README).
VITE_API_BASE=http://localhost:4000
